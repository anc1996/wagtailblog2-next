# =============================================================================
# WagtailBlog2 环境变量配置模板 (.env.example)
#
# 安全与边界红线：
# 1. 本模板仅用于说明配置键与开发安全值，默认值严格保持独立隔离；
# 2. 默认值严禁指向旧站/生产 MySQL、MongoDB、Redis、MinIO、ES 或 Celery；
# 3. 本地开发应复制本文件为 .env，生产环境切勿提交真实密钥；
# 4. 未经用户具体书面授权，严禁连接任何已承载旧站数据的服务实例。
# =============================================================================

# Django 核心运行配置
DJANGO_SETTINGS_MODULE=wagtailblog2.settings.dev
SECRET_KEY=django-insecure-wagtailblog2-dev-placeholder-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Wagtail 基础配置
WAGTAIL_SITE_NAME=WagtailBlog2
WAGTAILADMIN_BASE_URL=http://localhost:8000

# 数据库配置（隔离占位说明：骨架阶段默认使用本地 SQLite 路径，严禁指向旧站数据库）
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=var/db.sqlite3

# =============================================================================
# 新站基础设施配置键占位说明（全部注释；仅说明键名与阶段，不构成连接授权）
#
# 通用规则：
# - 阶段顺序（依据 说明书/00-产品需求与项目管理/12-新站基础设施与数据库初始化方案.md 的启用顺序表，仍为待审定提案）：
#   MySQL(P0-E3) -> MinIO(P1) -> MongoDB(P3) -> Redis/Celery(按需，MongoDB 之后)
#   -> Elasticsearch(P5)。未到阶段的服务保持关闭、不注入凭据、不做探活。
# - 每个服务使用新站专属库/桶/前缀/索引与分角色账号；不得靠命名约定共享旧站实例。
# - 严禁填入旧站或生产的主机、库名、账号、密钥；严禁默认指向任何远端地址。
# - 下列值均为 <占位符>；真实地址与凭据只写入本地未跟踪的 .env 或密钥管理系统，
#   且须在对应阶段获得具体授权后才可启用，不得提交到 Git。
# =============================================================================

# --- 1. MySQL（P0-E3：持久身份与迁移路线获批并取得建库授权后才启用）---
# 骨架阶段继续使用上方 SQLite；启用后改为独立空库与独立账号（运行/迁移/备份账号分权）。
# DATABASE_URL=mysql://<RUNTIME_USER>:<RUNTIME_PASSWORD>@<MYSQL_HOST>:3306/wagtailblog2_next_test

# --- 2. MinIO / S3（P1：仅图片及原件/派生保护；取得 P1 授权后才启用）---
# 桶为新站专属，私有原件、受限派生、公开副本分层；不得整桶公开。
# AWS_S3_ENDPOINT_URL=<MINIO_ENDPOINT_URL>
# AWS_STORAGE_BUCKET_NAME=wagtailblog2-next-test
# AWS_ACCESS_KEY_ID=<MINIO_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<MINIO_SECRET_KEY>

# --- 3. MongoDB（P3：外置不可变版本；P3 合同获批后才建专属库/账号/集合）---
# MONGODB_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@<MONGO_HOST>:27017/wagtailblog2_next_test

# --- 4. Redis / Celery（按需，顺序在 MongoDB 之后；由实际缓存或异步切片申请）---
# 非权威存储；默认继续使用本地进程内缓存。使用独立实例或独立库号与前缀，
# 不与旧站队列、任务名或 broker 共用。
# REDIS_URL=redis://<REDIS_HOST>:6379/<NEW_SITE_DB_INDEX>
# REDIS_KEY_PREFIX=wb2:next:test:
# CELERY_BROKER_URL=<CELERY_BROKER_URL>
# CELERY_RESULT_BACKEND=<CELERY_RESULT_BACKEND>
# CELERY_DEFAULT_QUEUE=wb2.next.test.default
# CELERY_QUEUE_PREFIX=wb2.next.test.

# --- 5. Elasticsearch（P5：可重建投影；读取/Outbox/权限回查/单写者合同具备后才启用）---
# 使用专属索引、alias 与角色；P0/P1 不启用。
# ELASTICSEARCH_URL=<ES_ENDPOINT_URL>
# ELASTICSEARCH_INDEX_PREFIX=wagtailblog2-next-test-
# ELASTICSEARCH_READ_ALIAS=wagtailblog2-next-test-content-read
# ELASTICSEARCH_WRITE_ALIAS=wagtailblog2-next-test-content-write
# ELASTICSEARCH_USERNAME=<ES_USER>
# ELASTICSEARCH_PASSWORD=<ES_PASSWORD>
